FROM devfest-rust:builder AS build
WORKDIR /lean
ENV CARGO_BUILD_JOBS=2
# Keep SQLite's generated SQL grammar intact. Disable optional extension modules.
# WAL, FULL synchronous, transactions, indexes, uniqueness and recovery remain enabled.
ENV CFLAGS="-Os -ffunction-sections -fdata-sections -USQLITE_ENABLE_FTS3 -USQLITE_ENABLE_FTS3_PARENTHESIS -USQLITE_ENABLE_FTS5 -USQLITE_ENABLE_RTREE -USQLITE_ENABLE_DBSTAT_VTAB -USQLITE_ENABLE_STAT4 -USQLITE_ENABLE_MEMORY_MANAGEMENT -USQLITE_SOUNDEX -DSQLITE_OMIT_JSON -DSQLITE_OMIT_UTF16 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_OMIT_SHARED_CACHE -DSQLITE_OMIT_DEPRECATED -DSQLITE_OMIT_TRACE -DSQLITE_OMIT_PROGRESS_CALLBACK -DSQLITE_OMIT_AUTHORIZATION -DSQLITE_OMIT_COMPILEOPTION_DIAGS -DSQLITE_OMIT_COMPLETE -DSQLITE_OMIT_INCRBLOB -DSQLITE_DEFAULT_MEMSTATUS=0"
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
RUN --mount=type=cache,id=lean-small-target,target=/lean/target --mount=type=cache,target=/usr/local/cargo/registry cargo build --release --locked && mkdir -p /runtime/data && chown 10001:10001 /runtime/data && cp target/release/devfest-lean /runtime/devfest-lean
FROM scratch
COPY --from=build /runtime/devfest-lean /devfest-lean
COPY --from=build --chown=10001:10001 /runtime/data /data
ENV PORT=8080 DATA_DIR=/data
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/devfest-lean"]
